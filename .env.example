# GitHub Token (com escopo 'repo' para criar repositório e enviar commits)
GITHUB_TOKEN="ghp_seuTokenAqui"

# Firebase Config (copie do Firebase Console > Configurações do Projeto)
FIREBASE_API_KEY="sua_api_key"
FIREBASE_AUTHDOMAIN="seu-projeto.firebaseapp.com"
FIREBASE_projectId="seu-projeto"
FIREBASE_storageBucket="seu-projeto.firebasestorage.app"
FIREBASE_messagingSenderId="123456789"
FIREBASE_appId="1:123456789:web:abcdef123456"

